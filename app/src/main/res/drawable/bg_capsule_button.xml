<?xml version="1.0" encoding="utf-8"?>
<!-- O-2 崩溃报告 / O-3 更新弹窗 / L Snackbar 同款「胶囊按钮」背景：
     - 圆角 radius_md = 14dp（chip 同款）
     - 0.5dp card_stroke 描边（与搜索框/空态插画/卡片同款）
     - 按压态：brand_10 初音绿半透明蒙层（按下时品牌反馈，不抢激活态）
     - 普通态：card 纯色 + 0.5dp card_stroke
     - 按钮文字：品牌绿 brand，bold 14sp，textAllCaps=false（在 layout 写）-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="@color/brand_10" />
          <corners android:radius="@dimen/radius_md" />
        </shape>
      </item>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="@color/card" />
          <stroke android:width="0.5dp" android:color="@color/card_stroke" />
          <corners android:radius="@dimen/radius_md" />
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:state_enabled="false">
    <shape android:shape="rectangle">
      <solid android:color="@color/chip_unselected" />
      <stroke android:width="0.5dp" android:color="@color/card_stroke" />
      <corners android:radius="@dimen/radius_md" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/card" />
      <stroke android:width="0.5dp" android:color="@color/card_stroke" />
      <corners android:radius="@dimen/radius_md" />
    </shape>
  </item>
</selector>
