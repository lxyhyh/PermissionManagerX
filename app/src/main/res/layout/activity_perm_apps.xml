<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <!-- GeekOS 胶囊批量按钮：允许=主题色实心，禁用=描边 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <Button
      android:id="@+id/allow_all_v"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="4dp"
      android:layout_weight="1"
      android:background="@drawable/capsule_fill"
      android:backgroundTint="?attr/accentColor"
      android:paddingHorizontal="20dp"
      android:stateListAnimator="@null"
      android:text="@string/perm_view_allow_all"
      android:textColor="@color/textOnPrimary"
      android:textSize="14sp" />

    <Button
      android:id="@+id/deny_all_v"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:layout_weight="1"
      android:background="@drawable/capsule_accent_outline"
      android:paddingHorizontal="20dp"
      android:stateListAnimator="@null"
      android:text="@string/perm_view_deny_all"
      android:textColor="?attr/accentColor"
      android:textSize="14sp" />
  </LinearLayout>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recycler_view"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:scrollbars="vertical" />
</LinearLayout>