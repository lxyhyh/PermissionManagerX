<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮底栏（底部 Tab 胶囊）背景：大圆角 22dp + 卡片色 + 1px 初音绿描边 + 现代悬浮阴影
     注意：阴影在 Android 5- 需要 elevation；这里同时写 elevation 9dp + outlineSpotShadow（Android 9+）
     保证 MIUI/鸿蒙/原生 Android 都能出"悬浮"感。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 1) 阴影占位层（API <21 退化为半透明黑条，可接受） -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@android:color/transparent" />
    </shape>
  </item>
  <!-- 2) 卡片主体 -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/card" />
      <!-- 描边 1dp：初音绿 14% 透明层（和 scheme 一致的 card_stroke） -->
      <stroke android:width="1dp" android:color="@color/card_stroke" />
      <!-- 大圆角 22dp（dimens radius_xl） -->
      <corners android:radius="@dimen/radius_xl" />
    </shape>
  </item>
</layer-list>
