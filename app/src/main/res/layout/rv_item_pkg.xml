<?xml version="1.0" encoding="utf-8"?>
<!-- ===== 应用列表卡片（rv_item_pkg.xml）按方案三 MIUI X + 苹果风格重写
     对齐规则（关键，不能乱改）：
       - 卡片整体宽度 match_parent，外层 RecyclerView 已经 paddingStart=LX → 卡片左边缘 = LX（不越过装饰条）
       - 卡片内部左 padding = @dimen/card_padding_h（14dp），即应用图标/文字等从卡片内 14dp 起
       - Switch/右侧任何元素：marginStart=auto → 推到右边缘，不靠中间（符合主流 App 设计）
       - ORANGE/RED/GREEN 引用色条（ref_indication_v）ID 保留，Java 还调用 setBackgroundColor
     资源尺寸 dimens 全部跟随 values-w360dp：360dp 小屏 LX=16 / 图标 40 / padding 12
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_marginBottom="@dimen/card_gap"
  android:orientation="vertical">

  <!-- 外层大圆角卡片，点击态自带初音绿10%提亮（bg_list_card selector）
       elevation=3dp + outlineProvider=background → 柔和投影（MIUI 阴影：扩散大、强度弱，不生硬）
       translationZ=1dp → Android 5+ 强制把阴影渲染在 z 轴，不和背景层混色 -->
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_card"
    android:elevation="3dp"
    android:translationZ="1dp"
    android:outlineProvider="background"
    android:addStatesFromChildren="true">

    <!-- 状态指示色条（ref_indication_v）：宽 4dp × 高 match_parent，圆角 4dp（与顶部装饰竖线同款，所有卡片装饰条统一）
         位置：marginStart = @dimen/card_padding_h = 14dp（从卡片内边距起点起=卡内 LX' 装饰条位置）
         正常隐藏=INVISIBLE（不占空间不挤压内容），Java 显示时 ref_indication_v.setBackgroundColor(ORANGE/RED/GREEN) 直接覆盖 → ⚠️ setBackgroundColor 会清掉默认 gradient，没关系；INVISIBLE/GONE 时还原默认样式，所以 drawable 先写成品牌同款竖线保持视觉一致性。
         layout_gravity=start（靠左），marginTop/Bottom=card_padding_v=12dp 保持卡片上下留白呼吸感，不贴边。 -->
    <View
      android:id="@+id/ref_indication_v"
      android:layout_width="4dp"
      android:layout_height="match_parent"
      android:layout_marginStart="@dimen/card_padding_h"
      android:layout_marginTop="@dimen/card_padding_v"
      android:layout_marginBottom="@dimen/card_padding_v"
      android:background="@drawable/decor_brand_vert_line"
      android:layout_gravity="start"
      android:visibility="invisible" />

    <!-- 卡片内容：图标 + 文字区（权重占满） -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingStart="@dimen/card_padding_h"
      android:paddingEnd="@dimen/card_padding_h"
      android:paddingTop="@dimen/card_padding_v"
      android:paddingBottom="@dimen/card_padding_v"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical">

      <!-- 应用图标 48dp（小屏 40dp），与 dimens.app_icon_size 一致 -->
      <ImageView
        android:id="@+id/icon_v"
        android:layout_width="@dimen/app_icon_size"
        android:layout_height="@dimen/app_icon_size"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

      <!-- 文字区（占满剩余空间）：应用名 + 包名 + 状态 + 权限数/日期 -->
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 行1：应用名（加粗，14.5sp）→ 居左 -->
        <TextView
          android:id="@+id/pkg_label_v"
          android:textStyle="bold"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/ink_1"
          android:textSize="@dimen/text_app_name"
          android:textAlignment="viewStart" />

        <!-- 行2：包名（次文字，12sp，ink_2）→ 居左 -->
        <TextView
          android:id="@+id/pkg_name_v"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/ink_2"
          android:textSize="@dimen/text_pkg_name"
          android:textAlignment="viewStart" />

        <!-- 行3：状态标签（Disabled/Framework/System...）→ 居左；gone 时不占空间
             颜色用 ?attr/accentColor = 初音绿 brand：浅色=深初音绿，暗黑=纯初音绿（避免 brand_dark 在暗黑太暗看不见） -->
        <TextView
          android:id="@+id/pkg_state_v"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="?attr/accentColor"
          android:textSize="11.5sp"
          android:textStyle="bold"
          android:textAlignment="viewStart"
          app:autoSizeTextType="uniform" />

        <!-- 行4：权限数量 + 日期；权限数在左，日期推到最右（符合用户说的"所有状态/元信息靠两边边缘"） -->
        <com.mirfatif.permissionmanagerx.fwk.MyLinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">

          <TextView
            android:id="@+id/pkg_perm_count_v"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_2"
            android:textSize="11.5sp"
            android:textAlignment="viewStart" />

          <TextView
            android:id="@+id/date_v"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink_3"
            android:textAlignment="viewEnd"
            android:textSize="11.5sp" />

        </com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>
</LinearLayout>
