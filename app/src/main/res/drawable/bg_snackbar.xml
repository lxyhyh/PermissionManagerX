<?xml version="1.0" encoding="utf-8"?>
<!-- L Snackbar 统一背景：与列表/设置卡片同款 design token
     - 纯色 card（浅=白 card / 暗黑=#1C1C1E 深灰）
     - 0.5dp 极细 card_stroke 描边（品牌色 14% 透明，浅/深都有干净边界）
     - radius_md（14dp）中等圆角，比列表卡 18dp 小一号（次级提示 UI，层级比列表低）
     Snackbar 容器外层 elevation 6dp → 浮动阴影，比设置/列表卡 3dp 稍高但低于底栏 12dp -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/card" />
  <stroke android:width="0.5dp" android:color="@color/card_stroke" />
  <corners android:radius="@dimen/radius_md" />
</shape>
