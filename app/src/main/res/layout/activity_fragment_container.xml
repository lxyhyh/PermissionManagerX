<?xml version="1.0" encoding="utf-8"?>
<com.mirfatif.permissionmanagerx.fwk.MyLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@color/bg">

  <!-- ===== 顶部：初音绿装饰竖条 + 大标题「设置」
       对齐：paddingStart = align_LX，装饰条本身 marginStart=0（父容器padding=LX → 实际位置=LX）
       所有元素不超过装饰条左边缘 → paddingStart/marginStart ≥ 0 即可
  -->
  <com.mirfatif.permissionmanagerx.fwk.MyLinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/align_LX"
    android:paddingEnd="@dimen/align_LX"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <View
      android:layout_width="4dp"
      android:layout_height="22dp"
      android:layout_marginStart="0dp"
      android:layout_marginTop="6dp"
      android:background="@drawable/decor_brand_vert_line" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="-16dp"
      android:paddingStart="14dp"
      android:text="@string/settings_menu_item"
      android:textColor="@color/ink_1"
      android:textSize="@dimen/text_title"
      android:textStyle="bold"
      android:fontFamily="sans-serif-black"
      android:letterSpacing="-0.02" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="8dp"
      android:background="?attr/accentColor" />

  </com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>

  <!-- ===== 兼容老代码：异常筛选总开关（FilterSettingsFragment 可能用到？保留 ID + visibility=gone，原样不动） ===== -->
  <ToggleButton
    android:id="@+id/exc_filters_master_switch"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginStart="@dimen/align_LX"
    android:layout_marginEnd="@dimen/align_LX"
    android:textOff="@string/enable_exc_filters"
    android:textOn="@string/disable_exc_filters"
    android:visibility="gone" />

  <!-- ===== Fragment 容器：设置/高级设置/筛选设置 的 PreferenceFragmentCompat 都塞这里
           padding 给左右 LX，让 Preference 卡片与装饰条对齐；
           Preference 自身的 padding 会叠加，效果就是卡片不超过绿色装饰条。
  -->
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/fragment_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:paddingStart="@dimen/align_LX"
    android:paddingEnd="@dimen/align_LX"
    android:clipToPadding="false" />

</com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>
