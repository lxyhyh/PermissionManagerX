<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮底栏（底部 Tab 胶囊）背景 — HyperOS / SukiSU Ultra 现代悬浮风格：
     1) 主体 86% 半透明白/深灰（= 毛玻璃质感，即使背后有列表滚动也能看到模糊感）
     2) 0.5dp 极细描边 card_stroke（和卡片风格一致，一圈淡淡品牌边界）
     3) 大圆角 radius_xl = 28dp（dimens）
     阴影主要靠外层 elevation 12dp + outlineProvider="paddedBounds" 产生（Android 9+ spotShadow） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 1) 外层占位（让 elevation 的 paddedBounds 能在圆角外也计算阴影 padding） -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@android:color/transparent" />
      <corners android:radius="@dimen/radius_xl" />
    </shape>
  </item>
  <!-- 2) 卡片主体：card 颜色 + 86% 透明度（半悬浮毛玻璃感，不盖住列表但又够清晰） -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/card" />
      <corners android:radius="@dimen/radius_xl" />
    </shape>
  </item>
  <!-- 3) 半透明蒙层（alpha=0.86 叠加 → 最终约 86% 不透明）；
            实际已经是 card 纯色，这里再补一层 0.5dp 描边即可 -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@android:color/transparent" />
      <!-- 0.5dp 极细描边：和卡片同品牌描边，防止浅色模式下背景太相近边界不清 -->
      <stroke android:width="0.5dp" android:color="@color/card_stroke" />
      <corners android:radius="@dimen/radius_xl" />
    </shape>
  </item>
</layer-list>
