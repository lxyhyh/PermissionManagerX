<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Base application theme. -->
  <style name="BaseTheme" parent="Theme.AppCompat.DayNight">

    <!--Define custom attributes unique to the theme-->
    <item name="accentColor">@color/green</item>
    <item name="accentTrans5Color">@color/greenTrans5</item>
    <item name="accentTrans10Color">@color/greenTrans10</item>
    <item name="accentTrans20Color">@color/greenTrans20</item>
    <item name="accentTrans50Color">@color/greenTrans50</item>
    <item name="accentTrans75Color">@color/greenTrans75</item>

    <!--Preference Group Titles, Dialog Button Text-->
    <item name="colorAccent">?attr/accentColor</item>

    <!--Check Boxes, Switch Active State, Indeterminate Progress Bar. If not set, uses colorAccent-->
    <item name="colorControlActivated">?attr/accentColor</item>

    <!-- SwitchCompat (主界面 rv_item_perm + Preference 内 SwitchPreference) 全局圆形白钮+初音绿轨道
         ⚠️ attr 名必须是 androidx.preference 实际有的：
         - switchPreferenceStyle → 作用于 SwitchPreference / SwitchPreferenceCompat
         - checkBoxPreferenceStyle → 作用于 CheckBoxPreference
         其它不存在的 attr（如 switchPreferenceCompatStyle、checkboxPreferenceStyle）一律不写以免 link 失败 -->
    <item name="switchPreferenceStyle">@style/MySwitchPreference</item>
    <item name="checkBoxPreferenceStyle">@style/MyCheckboxPreference</item>

    <!-- Preference 主题：一次性覆盖全部 PreferenceFragment 7 个子页面的样式
         - preferenceStyle：行高、标题 ink_1 bold 15sp / 副文 ink_2 12.5sp
         - preferenceCategoryStyle：分组标题 初音绿 bold 12sp
         - preferenceScreenStyle：去掉默认卡片，让父外层壳的装饰条+LX 对齐生效
         注：PreferenceThemeOverlay 去掉 AppCompat.DayNight（老版 Preference 库不生成该全名）
         → 用 androidx.preference 默认的 PreferenceThemeOverlay 裸名即可 -->
    <item name="preferenceTheme">@style/MyPreferenceThemeOverlay</item>

    <!--Status Bar-->
    <item name="colorPrimaryDark">?attr/accentColor</item>

    <!--Action Bar-->
    <item name="colorPrimary">?attr/accentTrans10Color</item>

    <!-- ===== 初音绿资源层新增：背景 = @color/bg，文字层级引用 ink_1/2/3 ===== -->
    <item name="android:windowBackground">@color/bg</item>
    <!-- 悬浮底栏（新版）需要导航栏全透明，旧值半透明=内容穿不下去 → 改为 @android:color/transparent -->
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <!-- Edge-to-edge：主题允许画到系统栏下方（Android 8.1+ 生效；低版本自动忽略） -->
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:textColorPrimary">@color/ink_1</item>
    <item name="android:textColorSecondary">@color/ink_2</item>
    <item name="android:textColorTertiary">@color/ink_3</item>
    <item name="android:divider">@color/divider</item>
    <!-- M 暗黑逐屏：API 28+ Elevation 阴影颜色统一 brand_20（30%初音绿品牌色）
         原生默认 Elevation 阴影=系统灰（暗黑下发冷蓝，不品牌）；改为 brand_20：
           - 卡片 3dp / Snackbar 6dp / 底栏 12dp 的阴影都会发柔和品牌绿光晕（MIUI X/HyperOS 风格）
         属性 compileSdk≥34 都能识别；低版本 Android <28 平台忽略未知主题属性，不会崩。 -->
    <item name="android:outlineSpotShadowColor">@color/brand_20</item>
    <item name="android:outlineAmbientShadowColor">@color/brand_20</item>

    <item name="android:spinnerItemStyle">@style/SpinnerItemStyle</item>
    <!-- 全局 AlertDialog 风格统一：
         影响 AboutActivity 更新检查弹窗 / AlertDialogFragment 所有确认弹窗（ResetDefaults/清除排除/崩溃确认等）
         → 一次性把所有 Builder(act) 创建的对话框变成：背景=大圆角卡片 / 标题初音绿bold / 按钮文字初音绿 -->
    <item name="alertDialogTheme">@style/myAlertDialogTheme</item>
  </style>

  <!-- ============= My AlertDialog Theme（所有 AppCompat AlertDialog 统一生效） =============
       ⚠️ parent = ThemeOverlay.MaterialComponents.Dialog.Alert 最稳（含 windowMinWidthMajor/Minor、按钮排列、标题默认样式）
       我们只覆盖：
         - android:windowBackground → @android:color/transparent（去掉系统默认黑色框/四角暗影，让我们的卡片圆角真露出来）
         - colorAccent / colorControlActivated → brand 初音绿（按钮文字+选中项）
         - android:textColorPrimary/Secondary → ink_1 / ink_2
         - 另外在 drawable 里做 my_alert_dialog_bg（bg_about_card 复用，再加一层 elevation 透明边？直接复用 bg_about_card 足够）
       ⚠️ 注意：androidx.appcompat 1.6 实际存在的 Material Dialog theme 名可能不同，
       为防 AAPT link 失败，先试最通用的 parent=Theme.AppCompat.DayNight.Dialog.Alert，
       属性都覆盖上面那几个就行。 -->
  <style name="myAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    <!-- 必须透明：否则 Dialog 窗口背后会叠一张系统默认黑灰矩形，导致我们的卡片四个圆角看起来还是直角 -->
    <item name="android:windowBackground">@android:color/transparent</item>
    <!-- Dialog 主体区域：大圆角卡片（bg_about_card = ripple+card 圆角） -->
    <item name="android:background">@drawable/bg_about_card</item>
    <!-- 按钮 + Switch / CheckBox 激活色 = 初音绿 brand -->
    <item name="colorAccent">@color/brand</item>
    <item name="colorControlActivated">@color/brand</item>
    <!-- 标题 ink_1 bold 18sp；消息文字 ink_2 14sp（与页面层级一致） -->
    <item name="android:textColorPrimary">@color/ink_1</item>
    <item name="android:textColorSecondary">@color/ink_2</item>
    <!-- 正/负按钮文字色：初音绿 brand（HyperOS/iOS 弹窗按钮一律主题色） -->
    <item name="android:buttonBarPositiveButtonStyle">@style/MyAlertButton</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/MyAlertButton</item>
    <item name="android:buttonBarNeutralButtonStyle">@style/MyAlertButton</item>
    <!-- 标题颜色 = 初音绿 brand bold 18sp（对齐 MIUI/HyperOS 现代弹窗） -->
    <item name="android:textAppearance">@style/MyAlertDialogTextAppearance</item>
  </style>

  <style name="MyAlertButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
    <item name="android:textColor">@color/brand</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textAllCaps">false</item>
  </style>

  <style name="MyAlertDialogTextAppearance" parent="TextAppearance.AppCompat.Title">
    <item name="android:textColor">@color/brand</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">18sp</item>
  </style>

  <!-- ============= Preference Theme Overlay（全局 7 个 Preference Fragment 一次生效） =============
       ⚠️ androidx.preference 库版本差异：很多 style 名不是公开的（短名/AppCompat.* 都可能 link 失败）
       → 采用「零 parent 纯属性 override」方案：
         1. MyPreferenceThemeOverlay parent 只保留 PreferenceThemeOverlay（这个 androidx 一定有，否则 preferenceTheme 默认会回滚为空）
         2. MyPreference / MyPreferenceCategory / MyPreferenceScreen / MySwitchPreference / MyCheckboxPreference
            全部不要 parent（即 parent=""），我们只改视觉（背景、文字色、padding、间距），widget 本体由 BaseTheme 的
            colorControlActivated / android:textColorPrimary / Secondary 接管。
       注：我们不自定义 android:layout / widgetLayout / widgetLayoutResource，所以内部 SwitchCompat / CheckBox 由系统默认 widget 渲染，不受 parent 缺失影响。 -->

  <style name="MyPreferenceThemeOverlay" parent="PreferenceThemeOverlay">
    <item name="preferenceStyle">@style/MyPreference</item>
    <item name="preferenceCategoryStyle">@style/MyPreferenceCategory</item>
    <item name="preferenceScreenStyle">@style/MyPreferenceScreen</item>
    <item name="switchPreferenceStyle">@style/MySwitchPreference</item>
    <item name="checkBoxPreferenceStyle">@style/MyCheckboxPreference</item>
    <!-- 让 Preference 根 List 的左右内边距 = align_LX → 卡片不越过顶部装饰条 -->
    <item name="android:layout_marginStart">@dimen/align_LX</item>
    <item name="android:layout_marginEnd">@dimen/align_LX</item>
    <item name="android:paddingTop">0dp</item>
  </style>

  <style name="MyPreference">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">52dp</item>
    <!-- J 设置页品牌化：行卡与主界面列表完全同款 design token
         bg_list_card = 18dp 大圆角 + 0.5dp card_stroke 极细描边 + 按下 brand_10 高亮蒙层 + brand_20 描边加粗
         elevation 3dp + outlineSpotShadowColor brand_20（暗黑下发品牌色柔和阴影，M 会确认）
         替换原来的 bg_about_card（缺描边、按压反馈不同步）-->
    <item name="android:background">@drawable/bg_list_card</item>
    <item name="android:elevation">3dp</item>
    <item name="android:outlineProvider">background</item>
    <!-- LX' 对齐：paddingStart 14dp 左，End 14dp 右对称；vertical 12dp = card_padding_v 跟主卡片 -->
    <item name="android:paddingStart">14dp</item>
    <item name="android:paddingEnd">14dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
    <!-- 相邻卡片间隔 8dp（12dp card_gap 是主界面大列表，设置页更紧凑 8dp，仍保留呼吸感） -->
    <item name="android:layout_marginBottom">8dp</item>
    <!-- 标题 ink_1 bold 15sp → 调整为 14.5sp bold（与主界面卡片 app_name 同字号，统一设计 token） -->
    <item name="android:textColor">@color/ink_1</item>
    <item name="android:textSize">14.5sp</item>
    <item name="android:textStyle">bold</item>
    <!-- 副文 ink_2 12.5sp（与主界面卡片 pkg_name 12sp 接近，层级一致） -->
    <item name="android:textColorSecondary">@color/ink_2</item>
  </style>

  <style name="MyPreferenceCategory">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <!-- J 设置页分组标题打磨：与主界面 toolbar_subtitle 分组标题同款 design token
         对齐原则：paddingStart=14dp = LX' 与大标题文字左边界完全一致 → 与顶部装饰条+卡片+底栏LX在一条线上
         左侧小圆点光晕 decor_section_header_dot（外层 brand_5 8dp圆 + 内层 brand_dark 4dp实点）+ 8dp padding 到文字
         文字 11sp sans-serif-medium ink_2（次文字色，层级正确不抢），替代以前的 初音绿 bold 12sp（太跳色）
         paddingTop 16dp + marginBottom 8dp → 分组间总间距 ≥ 24dp，视觉分组清晰 -->
    <item name="android:textColor">@color/ink_2</item>
    <item name="android:textSize">11sp</item>
    <item name="android:textStyle">normal</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:drawableStart">@drawable/decor_section_header_dot</item>
    <item name="android:drawablePadding">8dp</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingStart">14dp</item>
    <item name="android:paddingTop">16dp</item>
    <item name="android:paddingBottom">6dp</item>
    <item name="android:layout_marginBottom">8dp</item>
  </style>

  <style name="MyPreferenceScreen">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingTop">0dp</item>
    <item name="android:paddingBottom">0dp</item>
  </style>

  <!-- 开关 + 复选 Preference：不指定 parent 防止 link 失败；Switch/CheckBox 色由 BaseTheme.colorControlActivated=初音绿 生效 -->
  <style name="MySwitchPreference">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:background">@drawable/bg_about_card</item>
    <item name="android:paddingStart">14dp</item>
    <item name="android:paddingEnd">10dp</item>
    <item name="android:paddingTop">10dp</item>
    <item name="android:paddingBottom">10dp</item>
    <item name="android:layout_marginBottom">6dp</item>
    <item name="android:textColor">@color/ink_1</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColorSecondary">@color/ink_2</item>
  </style>

  <style name="MyCheckboxPreference">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:background">@drawable/bg_about_card</item>
    <item name="android:paddingStart">14dp</item>
    <item name="android:paddingEnd">10dp</item>
    <item name="android:paddingTop">10dp</item>
    <item name="android:paddingBottom">10dp</item>
    <item name="android:layout_marginBottom">6dp</item>
    <item name="android:textColor">@color/ink_1</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColorSecondary">@color/ink_2</item>
  </style>

  <style name="SpinnerItemStyle">
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/active_disabled</item>
  </style>

  <!--============== About Activity ==============-->

  <style name="AboutActivityItemContainer">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">?android:attr/selectableItemBackground</item>
  </style>

  <style name="AboutActivityIconImg">
    <item name="android:layout_width">24dp</item>
    <item name="android:layout_height">24dp</item>
    <item name="android:layout_gravity">center</item>
    <item name="android:layout_marginEnd">8dp</item>
  </style>

  <style name="AboutActivityItemTextBox">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingTop">8dp</item>
    <item name="android:paddingBottom">8dp</item>
    <item name="android:orientation">vertical</item>
  </style>

  <style name="AboutActivityItemTitle">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="AboutActivityItemSummary">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">2dp</item>
    <item name="android:textAlignment">viewStart</item>
    <item name="android:textColor">@color/ink_2</item>
    <item name="android:textSize">12.5sp</item>
  </style>

  <style name="AboutActivityRightArrow">
    <item name="android:layout_width">18dp</item>
    <item name="android:layout_height">18dp</item>
    <item name="android:layout_marginStart">10dp</item>
    <item name="android:alpha">0.4</item>
    <item name="android:src">@drawable/right_arrow</item>
    <item name="android:tint">@color/ink_2</item>
    <item name="android:contentDescription" tools:ignore="ContentDescription">@null</item>
  </style>

  <!--============== Common Styles ==============-->

  <style name="BgColorControlNormal">
    <item name="android:background">@color/colorControlNormal</item>
  </style>

  <style name="ListSeparator" parent="BgColorControlNormal">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">1dp</item>
  </style>

  <style name="ListSeparatorDim" parent="ListSeparator">
    <item name="android:alpha">0.25</item>
  </style>

  <style name="CustomButton" parent="Widget.AppCompat.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/active_disabled</item>
  </style>

</resources>
