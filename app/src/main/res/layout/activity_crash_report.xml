<?xml version="1.0" encoding="utf-8"?>
<!--
  崩溃报告页（CrashReportActivity）外层壳：和我的页/设置页完全一致的初音绿装饰条 + 大标题 + LX对齐。
  老 ID 100% 保留（ActivityCrashReportBinding + CrashReportActivity.kt 使用）：
    prog_cont / prog_msg / report_cont / content_v / submit_button
-->
<com.mirfatif.permissionmanagerx.fwk.MyLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@color/bg">

  <!-- ===== 顶部：初音绿装饰竖条 + 小圆点光晕大标题 + 180dp 品牌空态插画占位（O-2）
           对齐：paddingStart/End = align_LX；装饰竖条 marginStart=0
           插画：居中 180dp decor_crash_report_illu_placeholder（比主空态 140dp 放大 40dp）+ marginTop 14dp
           标题：submit_report_button / crash_report 文案 crashPageTitleV；描述："send_crash_report_summary" ink_2 13sp；
           大标题下方再 section 小圆点：18sp → 对应 text_title，和权限详情页 section header 同款一致 -->
  <com.mirfatif.permissionmanagerx.fwk.MyLinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/align_LX"
    android:paddingEnd="@dimen/align_LX"
    android:paddingTop="16dp"
    android:paddingBottom="10dp"
    android:gravity="center_horizontal">

    <com.mirfatif.permissionmanagerx.fwk.MyLinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- 初音绿装饰竖条：4dp × 22dp 圆角 4dp（同主界面/权限详情页） -->
      <View
        android:layout_width="4dp"
        android:layout_height="22dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/decor_brand_vert_line" />

      <!-- 大标题：18sp ink_1 bold（比 26sp text_title 小一级；O-2 崩溃报告页不是主标题，更紧凑精致）
           paddingStart=14dp（装饰条右侧 10dp 起，与权限详情页/主界面保持） -->
      <TextView
        android:id="@+id/crash_page_title_v"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:paddingStart="14dp"
        android:text="@string/submit_report_button"
        android:textColor="@color/ink_1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.01" />

      <!-- Section 副标题：小圆点光晕 + send_crash_report_summary（"Send crash logs to the developers"）
           对齐：paddingStart=14dp；13sp ink_2；小圆点与文字基线居中对齐 -->
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <View
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="start|center_vertical"
          android:background="@drawable/decor_section_header_dot"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/crash_page_subtitle_v"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:layout_marginStart="16dp"
          android:gravity="center_vertical"
          android:text="@string/send_crash_report_summary"
          android:textColor="@color/ink_2"
          android:textSize="13sp"
          android:textStyle="normal"
          android:fontFamily="sans-serif-medium" />
      </FrameLayout>

      <!-- 品牌分隔线：1dp brand_20（与主界面/权限详情页同款） -->
      <View
        android:id="@+id/top_accent_stroke"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="?attr/accentColor" />

    </com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>

    <!-- O-2 大插画占位：180dp 居中 + marginTop 14dp
         decor_crash_report_illu_placeholder（card 大圆 + 0.5dp stroke + 中心 8×80dp 品牌竖线渐变）-->
    <ImageView
      android:layout_width="180dp"
      android:layout_height="180dp"
      android:layout_marginTop="14dp"
      android:src="@drawable/decor_crash_report_illu_placeholder"
      android:contentDescription="@null" />

  </com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>

  <!-- ===== 进度展示区（读取崩溃日志时显示）—— prog_cont + prog_msg 两个ID 完整保留 ===== -->
  <com.mirfatif.permissionmanagerx.fwk.MyLinearLayout
    android:id="@+id/prog_cont"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginStart="@dimen/align_LX"
    android:layout_marginEnd="@dimen/align_LX"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_about_card"
    android:gravity="center"
    android:orientation="vertical">

    <ProgressBar
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_gravity="center"
      android:layout_marginBottom="8dp"
      android:indeterminate="true"
      android:indeterminateBehavior="cycle"
      android:indeterminateTint="?attr/accentColor"
      android:progressTint="?attr/accentColor" />

    <TextView
      android:id="@+id/prog_msg"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:paddingHorizontal="8dp"
      android:text="@string/reading_crash_log_file"
      android:textColor="@color/ink_2"
      android:textSize="14sp" />

  </com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>

  <!-- ===== 报告内容区（崩溃日志内容 + 提交按钮）—— report_cont / content_v / submit_button 三个ID 完整保留 ===== -->
  <com.mirfatif.permissionmanagerx.fwk.MyLinearLayout
    android:id="@+id/report_cont"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginStart="@dimen/align_LX"
    android:layout_marginEnd="@dimen/align_LX"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="96dp"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- 日志内容卡片：大圆角包起来（原 crash_report_text_bg 直接在 NestedScrollView 背景 → 外层再包我们的卡片也不冲突） -->
    <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/bg_about_card"
      android:paddingHorizontal="12dp"
      android:paddingTop="10dp"
      android:paddingBottom="10dp">

      <HorizontalScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
          android:id="@+id/content_v"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="monospace"
          android:textColor="@color/ink_1"
          android:textSize="12sp"
          android:lineSpacingExtra="2dp" />

      </HorizontalScrollView>

    </androidx.core.widget.NestedScrollView>

    <!-- 提交按钮行：右对齐，初音绿 bold 文字（胶囊按钮 bg_capsule_button）
         submit_button 老 ID 保留；enabled=false 时显示 chip_unselected 禁用态（bg_capsule_button 已处理）
         paddingHorizontal 16dp paddingVertical 8dp；胶囊内文字 14sp brand bold，textAllCaps=false -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:paddingHorizontal="4dp">

      <Button
        android:id="@+id/submit_button"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:enabled="false"
        android:text="@string/submit_report_button"
        android:textColor="@color/brand"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_capsule_button"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    </FrameLayout>

  </com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>

</com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>
