<?xml version="1.0" encoding="utf-8"?>
<!--
  单个权限详情对话框（Permission 点击弹出，PermDetailDialog.java 使用）
  - 整体 bg_about_card 大圆角（外层调用的 Dialog windowBackground 需配合；
    这里至少保证内容区卡片风格一致 + LX 对齐 + 文字层级 ink_1/2/3）
  - 6 个老 ID 完整保留：
    perm_name_v / perm_name_sub_v
    depends_perm_name_cont / depends_perm_name_v
    prot_level_v
    perm_desc_v
-->
<com.mirfatif.permissionmanagerx.fwk.MyLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:background="@drawable/bg_about_card"
  android:paddingStart="@dimen/align_LX"
  android:paddingEnd="@dimen/align_LX"
  android:paddingTop="18dp"
  android:paddingBottom="18dp">

  <!-- 1) 权限名称大标题（17sp bold ink_1） -->
  <TextView
    android:id="@+id/perm_name_v"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:textAlignment="viewStart"
    android:textColor="@color/ink_1"
    android:textSize="17sp"
    android:textStyle="bold"
    android:fontFamily="sans-serif-black" />

  <!-- 2) 权限名称副标题（默认 gone，13sp ink_2） -->
  <TextView
    android:id="@+id/perm_name_sub_v"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:textAlignment="viewStart"
    android:textColor="@color/ink_2"
    android:textSize="13sp"
    android:visibility="gone" />

  <!-- 3) 依赖权限（默认 gone） -->
  <LinearLayout
    android:id="@+id/depends_perm_name_cont"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="true"
    android:layout_marginBottom="8dp"
    android:visibility="gone">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="6dp"
      android:text="@string/depends_on"
      android:textColor="@color/ink_2"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/depends_perm_name_v"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="?attr/accentColor"
      android:textSize="12sp"
      android:textStyle="bold" />

  </LinearLayout>

  <!-- 4) 保护级别一行（标签 + 值，垂直居中） -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_marginBottom="10dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="6dp"
      android:gravity="center_vertical"
      android:text="@string/protection_level"
      android:textColor="@color/ink_2"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/prot_level_v"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:textColor="@color/ink_1"
      android:textSize="12.5sp" />

  </LinearLayout>

  <!-- 5) 权限描述（默认 gone） -->
  <TextView
    android:id="@+id/perm_desc_v"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:lineSpacingExtra="2dp"
    android:textColor="@color/ink_2"
    android:textSize="13sp"
    android:visibility="gone" />

</com.mirfatif.permissionmanagerx.fwk.MyLinearLayout>
